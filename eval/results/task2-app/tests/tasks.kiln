test "owner toggles a task"
  seed User email="a@example.com" id=1 name="A"
  seed User email="b@example.com" id=2 name="B"
  seed Project id=1 owner=1 title="Site"
  seed Task done=false id=1 project=1 rank=0 title="Ship it"
  as user=1
  call toggle_task done=true id=1
  expect Task[1].done == true
  expect denied when as user=2

test "detail page lists tasks"
  seed User email="a@example.com" id=1 name="A"
  seed Project id=1 owner=1 title="Site"
  seed Task done=false id=1 project=1 rank=0 title="Ship it"
  as user=1
  visit /projects/1
  expect text "Ship it"

test "owner archives a task"
  seed User email="a@example.com" id=1 name="A"
  seed User email="b@example.com" id=2 name="B"
  seed Project id=1 owner=1 title="Site"
  seed Task archived=false done=false id=1 project=1 rank=0 title="Ship it"
  as user=1
  call archive_task id=1
  expect Task[1].archived == true
  expect denied when as user=2

test "archived tasks are hidden from the list"
  seed User email="a@example.com" id=1 name="A"
  seed Project id=1 owner=1 title="Site"
  seed Task archived=false done=false id=1 project=1 rank=0 title="Ship it"
  seed Task archived=true done=false id=2 project=1 rank=1 title="Old thing"
  as user=1
  visit /projects/1
  expect text "Ship it"
