test "owner toggles a task"
  seed User email="a@example.com" id=1 name="A"
  seed User email="b@example.com" id=2 name="B"
  seed Project id=1 owner=1 title="Site"
  seed Task done=false id=1 project=1 rank=0 title="Ship it"
  as user=1
  call toggle_task done=true id=1
  expect Task[1].done == true
  expect denied when as user=2

test "detail page lists tasks"
  seed User email="a@example.com" id=1 name="A"
  seed Project id=1 owner=1 title="Site"
  seed Task done=false id=1 project=1 rank=0 title="Ship it"
  as user=1
  visit /projects/1
  expect text "Ship it"

test "project list links to each project"
  seed User email="a@example.com" id=1 name="A"
  seed Project created="2026-01-01" id=1 owner=1 title="Older site"
  seed Project created="2026-06-01" id=2 owner=1 title="Newer site"
  as user=1
  visit /projects
  expect text "Newer site"

test "the project list is signed in only"
  visit /projects
  expect redirect /login

test "another user's projects are not listed"
  seed User email="a@example.com" id=1 name="A"
  seed User email="b@example.com" id=2 name="B"
  seed Project id=1 owner=1 title="Mine"
  seed Project id=2 owner=2 title="Theirs"
  as user=1
  visit /projects
  expect text "Mine"
  expect no text "Theirs"
